# ==============================================================================
# NarrativeLens AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your local environment
# ==============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://narrativelens:narrativelens@localhost:5432/narrativelens
DATABASE_SYNC_URL=postgresql://narrativelens:narrativelens@localhost:5432/narrativelens

# Redis
REDIS_URL=redis://localhost:6379/0

# Models
CLASSIFIER_MODEL_ID=FacebookAI/xlm-roberta-base
CLASSIFIER_CHECKPOINT_PATH=
GENERATION_MODEL_ID=Qwen/Qwen3-4B
EMBEDDING_MODEL_ID=BAAI/bge-m3
VISION_MODEL_ID=openai/clip-vit-base-patch32
MULTIMODAL_MODEL_ID=openai/clip-vit-base-patch32
OCR_ENABLED=false
LLM_PROVIDER=local
MODEL_DEVICE=auto
MODEL_LOAD_MODE=lazy

# Application
APP_NAME=NarrativeLens AI
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# Search (optional)
SEARXNG_URL=
SEARCH_PROVIDER=none

# Social & Video APIs (optional)
YOUTUBE_API_KEY=

# Local LLM Context Arbiter (Ollama - free & local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ENABLE_LLM_CONTEXT_ARBITER=true
